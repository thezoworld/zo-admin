# API base URLs
NEXT_PUBLIC_API_BASE_URL=https://api.io.zo.xyz
NEXT_PUBLIC_API_BASE_URL_ZOSTEL=https://api.zostel.com

# Client identifiers (sent as headers to the backends)
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_ZOSTEL_APP_ID=

# Optional: sockets / third-party
NEXT_PUBLIC_API_SOCKET_URL=wss://api.io.zo.xyz
NEXT_PUBLIC_GIPHY_API_KEY=
NEXT_PUBLIC_RECAPTCHA_KEY=

# Optional: Sentry. Leaving these empty disables Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Feature flags
# Set to "on" to gate /dashboard/* via the httpOnly-cookie middleware path.
# Requires POSTing /api/auth/session after login to set the cookie.
NEXT_PUBLIC_AUTH_COOKIE_FLOW=
